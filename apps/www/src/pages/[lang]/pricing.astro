---
import RootLayout from '../../components/RootLayout.astro';
import Pricing from '../../components/Pricing.astro';
import {
  DEFAULT_LOCALE,
  WWW_SUPPORTED_LOCALES,
  localePath,
  makeTranslator,
} from '../../i18n/translations';

export function getStaticPaths() {
  return WWW_SUPPORTED_LOCALES.filter((loc) => loc !== DEFAULT_LOCALE).map(
    (loc) => ({ params: { lang: loc } }),
  );
}

const { lang } = Astro.params;
if (!lang) throw new Error('lang param missing');
const t = makeTranslator(lang);

const breadcrumbs = [
  { name: t('site.name'), url: localePath(lang, '/') },
  { name: t('pricing.title'), url: localePath(lang, '/pricing') },
];
---

<RootLayout
  locale={lang}
  t={t}
  title={t('pricing.metaTitle')}
  description={t('pricing.metaDescription')}
  breadcrumbs={breadcrumbs}
  contained={false}
>
  <Pricing t={t} />
</RootLayout>
