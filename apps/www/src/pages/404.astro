---
import RootLayout from '../components/RootLayout.astro';
import Hero from '../components/Hero.astro';
import {
  DEFAULT_LOCALE,
  DEFAULT_LOCALE_ONLY,
  localePath,
  makeTranslator,
} from '../i18n/translations';

const locale = DEFAULT_LOCALE;
const t = makeTranslator(locale);
---

<RootLayout
  locale={locale}
  t={t}
  title={t('notFound.metaTitle')}
  description={t('notFound.metaDescription')}
  noindex={true}
  availableLocales={DEFAULT_LOCALE_ONLY}
  contained={false}
>
  <Hero compact>
    <h1>{t('notFound.title')}</h1>
    <p class="lead">{t('notFound.description')}</p>

    <div class="btn-row">
      <a class="btn primary" href="https://app.feynote.com">{t('nav.goToApp')}</a>
      <a class="btn outline" href={localePath(locale, '/')}>
        {t('notFound.backHome')}
      </a>
    </div>
  </Hero>

  <section class="section-shell suggestions">
    <h2>{t('notFound.suggestions')}</h2>
    <ul>
      <li>
        <a href={localePath(locale, '/features')}>{t('nav.features')}</a>
      </li>
      <li><a href={localePath(locale, '/pricing')}>{t('nav.pricing')}</a></li>
      <li><a href={localePath(locale, '/download')}>{t('nav.download')}</a></li>
      <li><a href="/blog/">{t('nav.blog')}</a></li>
      <li>
        <a href="https://docs.feynote.com" target="_blank" rel="noopener">
          {t('nav.docs')}
        </a>
      </li>
    </ul>
  </section>
</RootLayout>

<style>
  h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin: 0 0 12px;
  }

  .lead {
    margin: 0;
    font-size: 1.1rem;
    opacity: 0.92;
    max-width: 55ch;
  }

  .btn-row {
    margin-top: 28px;
  }

  .suggestions {
    padding-top: 48px;
  }

  .suggestions h2 {
    font-size: 1.4rem;
    margin: 0 0 16px;
  }

  .suggestions ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .suggestions a {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .suggestions a:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }
</style>
