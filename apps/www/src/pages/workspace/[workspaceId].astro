---
import {
  WorkspaceShareviewApp,
} from '@feynote/ui';
import {
  prisma
} from '@feynote/prisma/client';
import { buildShareMeta, isUuid } from '../../shareMeta';

export const prerender = false;

const { workspaceId } = Astro.params;

const workspace = isUuid(workspaceId)
  ? await prisma.workspace.findFirst({
      where: {
        id: workspaceId,
        deletedAt: null,
      },
      select: {
        id: true,
        name: true,
        linkAccessLevel: true,
      },
    })
  : null;

if (!workspace) {
  Astro.response.status = 404;
}

const linkShared = !!workspace && workspace.linkAccessLevel !== 'noaccess';

const meta = buildShareMeta({
  found: !!workspace,
  linkShared,
  title: workspace?.name || 'Workspace',
  url: Astro.url,
  site: Astro.site,
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="darkreader-lock" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={meta.robots} />
    {meta.canonical && <link rel="canonical" href={meta.canonical} />}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="FeyNote" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    {meta.canonical && <meta property="og:url" content={meta.canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <link rel="icon" type="image/x-icon" href="https://static.feynote.com/assets/favicon-20240925.ico" />
  </head>
  <body>
    {
      workspace ? (
        <>
          <div id="root" />
          <div id="referencePreviewContainer" />
          <WorkspaceShareviewApp id={workspace.id} client:only="react" />
        </>
      ) : (
        <main class="share-missing">
          <h1>{meta.title}</h1>
          <p>{meta.description}</p>
          <a href="/">Go to FeyNote</a>
        </main>
      )
    }
  </body>
</html>

<style>
  .share-missing {
    max-width: 40rem;
    margin: 15vh auto 0;
    padding: 0 24px;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
    text-align: center;
  }

  .share-missing a {
    color: #256be7;
  }
</style>
