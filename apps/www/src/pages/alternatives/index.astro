---
import RootLayout from '../../components/RootLayout.astro';
import Hero from '../../components/Hero.astro';
import DiscordButton from '../../components/DiscordButton.astro';
import { competitorList } from '../../data/competitors';
import { APP_URL } from '../../urls';
import {
  DEFAULT_LOCALE,
  DEFAULT_LOCALE_ONLY,
  makeTranslator,
} from '../../i18n/translations';

const locale = DEFAULT_LOCALE;
const t = makeTranslator(locale);

const title = 'Free, Open Source Alternatives to Note-Taking Apps - FeyNote';
const description =
  'Side-by-side comparisons of FeyNote with the note-taking and world-building apps people switch from most often. Free and open source.';

const breadcrumbs = [
  { name: t('site.name'), url: '/' },
  { name: 'Alternatives', url: '/alternatives/' },
];
---

<RootLayout
  locale={locale}
  t={t}
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  availableLocales={DEFAULT_LOCALE_ONLY}
  contained={false}
>
  <Hero compact>
    <p class="hub-eyebrow">Switching to FeyNote</p>
    <h1>A free, open source alternative to note-taking</h1>
    <p class="lead">
      Side-by-side comparisons with the note-taking apps people switch from
      most often. FeyNote is free, open source, and built for tabletop RPG
      players and world-builders.
    </p>
  </Hero>

  <article class="hub-body">
    <section class="section-shell">
      <h2>Pick your current app</h2>
      <ul class="hub-list">
        {
          competitorList.map((competitor) => (
            <li>
              <a class="card" href={`/alternatives/${competitor.slug}/`}>
                <strong>FeyNote vs {competitor.name}</strong>
                <span>{competitor.cardSummary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section-shell">
      <h2>Not sure which app to compare?</h2>
      <p>
        FeyNote is free, so there's really no reason not to give it a try. If
        we don't currently support importing from your favorite app, hop into
        our Discord and let us know. We'd love to help you.
      </p>
      <div class="btn-row">
        <a class="btn primary" href={APP_URL}>
          Create a free account
        </a>
        <DiscordButton />
      </div>
    </section>
  </article>
</RootLayout>

<style>
  .hub-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    opacity: 0.85;
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin: 0 0 12px;
  }

  .lead {
    margin: 0;
    font-size: 1.1rem;
    opacity: 0.92;
    max-width: 65ch;
  }

  .hub-body {
    line-height: 1.65;
    padding-bottom: 72px;
  }

  .hub-body .section-shell {
    padding-top: 56px;
  }

  .hub-body h2 {
    font-size: 1.8rem;
    margin: 0 0 16px;
  }

  .hub-body p {
    color: var(--text-muted);
    margin: 0 0 16px;
    max-width: 75ch;
  }

  .hub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .hub-list a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .hub-list a:hover {
    background: var(--surface-hover);
  }

  .hub-list strong {
    font-size: 1rem;
  }

  .hub-list span {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
