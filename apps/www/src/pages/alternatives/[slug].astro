---
import RootLayout from "../../components/RootLayout.astro";
import Comparison from "../../components/Comparison.astro";
import { competitors, competitorSlugs } from "../../data/competitors";

export function getStaticPaths() {
  return competitorSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
if (!slug || !(slug in competitors)) {
  throw new Error(`Unknown competitor slug: ${slug}`);
}
const competitor = competitors[slug];

const title = `${competitor.name} Alternative - Free & Open Source | FeyNote`;
const description = competitor.seoDescription ?? competitor.subtitle;

const homeURL = new URL("/", Astro.site).toString();
const hubURL = new URL("/alternatives/", Astro.site).toString();
const pageURL = new URL(`/alternatives/${competitor.slug}/`, Astro.site).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://feynote.com/#organization",
      "name": "FeyNote",
      "url": "https://feynote.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://static.feynote.com/icons/feynote-icon-original-20241220.png",
      },
      "sameAs": [
        "https://github.com/FeyNote/FeyNote",
        "https://discord.gg/Tz8trXrd4C",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://feynote.com/#website",
      "url": homeURL,
      "name": "FeyNote",
      "publisher": { "@id": "https://feynote.com/#organization" },
      "inLanguage": "en-US",
    },
    {
      "@type": "SoftwareApplication",
      "name": "FeyNote",
      "applicationCategory": "LifestyleApplication",
      "operatingSystem": ["Web"],
      "url": homeURL,
      "inLanguage": "en-US",
      "description":
        "Free note-taking app for world-builders and tabletop RPG players",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "FeyNote", "item": homeURL },
        { "@type": "ListItem", "position": 2, "name": "Alternatives", "item": hubURL },
        { "@type": "ListItem", "position": 3, "name": competitor.name, "item": pageURL },
      ],
    },
    {
      "@type": "FAQPage",
      "mainEntity": competitor.faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a,
        },
      })),
    },
    {
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": pageURL,
      "inLanguage": "en-US",
      "isPartOf": { "@id": "https://feynote.com/#website" },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "https://static.feynote.com/icons/feynote-icon-original-20241220.png",
      },
    },
  ],
};
---

<RootLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Comparison competitor={competitor} />
</RootLayout>
