---
import RootLayout from '../components/RootLayout.astro';
import Download from '../components/Download.astro';
import {
  DEFAULT_LOCALE,
  localePath,
  makeTranslator,
} from '../i18n/translations';

export const prerender = false;

const locale = DEFAULT_LOCALE;
const t = makeTranslator(locale);

const breadcrumbs = [
  { name: t('site.name'), url: localePath(locale, '/') },
  { name: t('download.title'), url: localePath(locale, '/download') },
];
---

<RootLayout
  locale={locale}
  t={t}
  title={t('download.metaTitle')}
  description={t('download.metaDescription')}
  breadcrumbs={breadcrumbs}
  contained={false}
>
  <Download t={t} />
</RootLayout>
