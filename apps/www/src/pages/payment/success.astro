---
import RootLayout from '../../components/RootLayout.astro'
import { DEFAULT_LOCALE_ONLY } from '../../i18n/translations';
---
<style>
  .center {
    text-align: center;
  }

  .main {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
<RootLayout
  title="Thank You - FeyNote"
  description="Thank you for supporting FeyNote! Your contribution helps us build the best free TTRPG note-taking app."
  noindex={true}
  availableLocales={DEFAULT_LOCALE_ONLY}
>
  <div class="main center">
    <h1>Thank You!</h1>

    We really appreciate your support and hope you enjoy using Feynote. If you have any questions or feedback, please don't hesitate to reach out to us on Discord. We're always looking for ways to improve!

    <br />
    <br />

    <a class="btn primary" href="https://app.feynote.com">Go to Web App</a>
  </div>
</RootLayout>
