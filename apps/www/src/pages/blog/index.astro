---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import RootLayout from '../../components/RootLayout.astro';
import Hero from '../../components/Hero.astro';
import {
  DEFAULT_LOCALE,
  DEFAULT_LOCALE_ONLY,
  makeTranslator,
} from '../../i18n/translations';

const locale = DEFAULT_LOCALE;
const t = makeTranslator(locale);

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const breadcrumbs = [
  { name: t('site.name'), url: '/' },
  { name: t('blog.title'), url: '/blog/' },
];
---

<RootLayout
  locale={locale}
  t={t}
  title={t('blog.metaTitle')}
  description={t('blog.metaDescription')}
  breadcrumbs={breadcrumbs}
  availableLocales={DEFAULT_LOCALE_ONLY}
  contained={false}
>
  <Hero compact>
    <h1>{t('blog.title')}</h1>
    <p class="lead">{t('blog.subtitle')}</p>
  </Hero>

  <section class="section-shell blog-listing">
    <ul class="posts">
      {
        sortedPosts.map((post) => (
          <li class="post card">
            <a href={`/blog/${post.id}/`}>
              {post.data.featuredImageUrl && (
                <Picture
                  src={post.data.featuredImageUrl}
                  alt={`${t('blog.featuredImageAlt')} ${post.data.title}`}
                  widths={[400, 800]}
                  sizes="(max-width: 800px) 92vw, 33vw"
                  formats={['avif', 'webp']}
                  loading="lazy"
                  decoding="async"
                  inferSize
                  layout="none"
                />
              )}
              <div class="post-body">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString()}
                </time>
                <h2>{post.data.title}</h2>
                <p>{post.data.preview}</p>
                <span class="read-more">{t('blog.readMore')}</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</RootLayout>

<style>
  h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin: 0 0 12px;
  }

  .lead {
    margin: 0;
    font-size: 1.1rem;
    opacity: 0.92;
    max-width: 55ch;
  }

  .blog-listing {
    padding-top: 48px;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .post {
    padding: 0;
    overflow: hidden;
  }

  .post a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .post :global(img) {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    flex: 1 0 auto;
  }

  .post time {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .post p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    flex: 1 0 auto;
  }

  .read-more {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .post:hover {
    border-color: var(--accent);
  }

  .post:hover .read-more {
    text-decoration: underline;
  }
</style>
