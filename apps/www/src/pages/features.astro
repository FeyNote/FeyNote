---
import RootLayout from '../components/RootLayout.astro';
import Features from '../components/Features.astro';
import {
  DEFAULT_LOCALE,
  localePath,
  makeTranslator,
} from '../i18n/translations';

const locale = DEFAULT_LOCALE;
const t = makeTranslator(locale);

const breadcrumbs = [
  { name: t('site.name'), url: localePath(locale, '/') },
  { name: t('features.title'), url: localePath(locale, '/features') },
];
---

<RootLayout
  locale={locale}
  t={t}
  title={t('features.metaTitle')}
  description={t('features.metaDescription')}
  breadcrumbs={breadcrumbs}
  contained={false}
>
  <Features t={t} />
</RootLayout>
