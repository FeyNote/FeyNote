---
import {
  PrintviewApp,
} from '@feynote/ui';
import {
  prisma
} from '@feynote/prisma/client';
import { isUuid } from '../../../shareMeta';

export const prerender = false;

const { artifactId } = Astro.params;

const artifact = isUuid(artifactId)
  ? await prisma.artifact.findFirst({
      where: {
        id: artifactId,
        deletedAt: null,
      },
      select: {
        id: true,
        title: true,
        linkAccessLevel: true,
      },
    })
  : null;

if (!artifact) {
  Astro.response.status = 404;
}

const title =
  artifact && artifact.linkAccessLevel !== 'noaccess'
    ? `${artifact.title} - FeyNote`
    : 'FeyNote';
const canonical = artifact
  ? new URL(`/artifact/${artifact.id}/`, Astro.site).toString()
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={`Print view for TTRPG content on FeyNote. Free note-taking app for D&D and tabletop RPG campaigns.`} />
    <meta name="darkreader-lock" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/x-icon" href="https://static.feynote.com/assets/favicon-20240925.ico" />
  </head>
  <body>
    {
      artifact ? (
        <>
          <div id="root" />
          <div id="referencePreviewContainer" />
          <PrintviewApp id={artifact.id} client:only="react" />
        </>
      ) : (
        <main class="share-missing">
          <h1>{title}</h1>
          <p>This content is unavailable or is no longer shared.</p>
          <a href="/">Go to FeyNote</a>
        </main>
      )
    }
  </body>
</html>

<style>
  .share-missing {
    max-width: 40rem;
    margin: 15vh auto 0;
    padding: 0 24px;
    font-family:
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
    text-align: center;
  }

  .share-missing a {
    color: #256be7;
  }
</style>
