---
import { localePath, type Translator } from '../i18n/translations';
import { APP_URL, DISCORD_INVITE_URL, GITHUB_URL } from '../urls';

interface Props {
  t: Translator;
  locale: string;
}

const { t, locale } = Astro.props;

const columns = [
  {
    heading: t('footer.product'),
    links: [
      {
        href: localePath(locale, '/features'),
        label: t('nav.features'),
        external: false,
      },
      {
        href: localePath(locale, '/pricing'),
        label: t('nav.pricing'),
        external: false,
      },
      {
        href: localePath(locale, '/download'),
        label: t('nav.download'),
        external: false,
      },
      {
        href: '/alternatives/',
        label: t('nav.alternatives'),
        external: false,
      },
      { href: APP_URL, label: t('nav.goToApp'), external: false },
    ],
  },
  {
    heading: t('footer.community'),
    links: [
      { href: '/blog/', label: t('nav.blog'), external: false },
      { href: 'https://docs.feynote.com', label: t('nav.docs'), external: true },
      {
        href: DISCORD_INVITE_URL,
        label: t('nav.discord'),
        external: true,
      },
      {
        href: GITHUB_URL,
        label: t('nav.github'),
        external: true,
      },
    ],
  },
  {
    heading: t('footer.legal'),
    links: [
      {
        href: localePath(locale, '/about'),
        label: t('nav.about'),
        external: false,
      },
      { href: '/tos/', label: t('footer.tos'), external: false },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-name">{t('site.name')}</div>
      <p>{t('footer.tagline')}</p>
    </div>

    {
      columns.map((column) => (
        <nav class="footer-column" aria-label={column.heading}>
          <h2>{column.heading}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    padding: 48px 24px;
    background: var(--footer-bg);
    color: var(--footer-text);
  }

  .footer-inner {
    max-width: 1500px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 32px;
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }

  .footer-name {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.2rem;
    margin-bottom: 8px;
  }

  .footer-brand p {
    margin: 0;
    max-width: 40ch;
    font-size: 0.9rem;
    opacity: 0.75;
  }

  .footer-column h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 12px;
    opacity: 0.7;
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-column a {
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .footer-column a:hover {
    opacity: 1;
    text-decoration: underline;
  }
</style>
