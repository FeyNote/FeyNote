---
import Hero from './Hero.astro';
import type { Translator } from '../i18n/translations';

interface Props {
  t: Translator;
}

const { t } = Astro.props;

const plans = [
  {
    title: t('pricing.free.title'),
    description: t('pricing.free.description'),
    items: [
      t('pricing.free.documents'),
      t('pricing.free.images'),
      t('pricing.free.devices'),
      t('pricing.free.history'),
      t('pricing.free.importer'),
      t('pricing.free.noAds'),
    ],
  },
  {
    title: t('pricing.contribute.title'),
    description: t('pricing.contribute.description'),
    items: [
      t('pricing.contribute.images'),
      t('pricing.contribute.attachments'),
      t('pricing.contribute.history'),
    ],
  },
];
---

<Hero compact>
  <h1>{t('pricing.title')}</h1>
  <p class="lead">{t('pricing.subtitle')}</p>
</Hero>

<section class="section-shell pricing-content">
  <div class="intro">
    <p>{t('pricing.intro.1')}</p>
    <p>{t('pricing.intro.2')}</p>
    <p>{t('pricing.intro.3')}</p>
  </div>

  <div class="plans">
    {
      plans.map((plan) => (
        <article class="plan card">
          <h2>{plan.title}</h2>
          <p>{plan.description}</p>
          <ul>
            {plan.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="btn-row">
    <a class="btn primary" href="https://app.feynote.com">{t('nav.goToApp')}</a>
  </div>
</section>

<style>
  h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    margin: 0 0 12px;
  }

  .lead {
    margin: 0;
    font-size: 1.1rem;
    opacity: 0.92;
    max-width: 55ch;
  }

  .pricing-content {
    padding-top: 48px;
  }

  .intro {
    max-width: 70ch;
    margin: 0 auto 40px;
  }

  .intro p {
    color: var(--text-muted);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    max-width: 820px;
    margin: 0 auto;
  }

  .plan h2 {
    margin: 0 0 8px;
    font-size: 1.3rem;
    text-align: center;
  }

  .plan > p {
    color: var(--text-muted);
    margin: 0 0 16px;
    text-align: center;
  }

  .plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .plan li {
    position: relative;
    padding-inline-start: 24px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .plan li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .pricing-content .btn-row {
    justify-content: center;
    margin-top: 40px;
  }
</style>
